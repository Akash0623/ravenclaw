[Unit]
Description=Ravenclaw AI Assistant (OpenClaw Gateway)
Documentation=https://github.com/Akash0623/ravenclaw
After=network-online.target docker.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ravenclaw
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
TimeoutStartSec=120
TimeoutStopSec=30

# Restart policy
Restart=on-failure
RestartSec=30

# Security
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/ravenclaw /home/%u/.openclaw

[Install]
WantedBy=multi-user.target
